# Advanced: Nginx reverse proxy with Next.js app (for production scale-up)
# This is optional - use only if you want to add reverse proxy, caching, etc.
# Usage: docker build -f .dockerfiles/Dockerfile.nginx -t privacy-tracker:nginx .

FROM node:18-alpine AS builder

WORKDIR /app

COPY app/package*.json ./
RUN npm ci --only=production
COPY app/ ./
RUN npm run build

FROM nginx:alpine

# Copy built Next.js app to nginx
COPY --from=builder /app/.next /usr/share/nginx/html/.next
COPY --from=builder /app/public /usr/share/nginx/html/public
COPY --from=builder /app/node_modules /usr/share/nginx/html/node_modules
COPY --from=builder /app/package*.json /usr/share/nginx/html/

# Copy nginx config
COPY .dockerfiles/nginx.conf /etc/nginx/nginx.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
